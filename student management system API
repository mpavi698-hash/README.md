import sqlite3

# Get student details
name = input("Enter Name: ")
age = int(input("Enter Age: "))
gender = input("Enter Gender: ")
city = input("Enter City: ")

# Validation
if name == "":
    print("Name cannot be empty")

elif age < 15 or age > 25:
    print("Age must be between 15 and 25")

elif gender != "Male" and gender != "Female" and gender != "Other":
    print("Invalid gender")

else:
    conn = sqlite3.connect("student.db")
    cursor = conn.cursor()

    cursor.execute("""
        INSERT INTO students(name, age, gender, city, created_at)
        VALUES (?, ?, ?, ?, datetime('now'))
    """, (name, age, gender, city))

    conn.commit()

    print("Student created")
    print("Student ID:", cursor.lastrowid)

    conn.close()

