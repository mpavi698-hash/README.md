import sqlite3

# Connect to database
conn = sqlite3.connect("student.db")

# Create cursor
cursor = conn.cursor()

# Create students table
cursor.execute("""
CREATE TABLE students (
    id INTEGER,
    name TEXT,
    age INTEGER,
    gender TEXT,
    city TEXT,
    created_at DATETIME
)
""")

# Insert sample data
cursor.execute("INSERT INTO students VALUES (1,'Priya',18,'Female','Chennai',datetime('now'))")
cursor.execute("INSERT INTO students VALUES (2,'Arjun',19,'Male','Coimbatore',datetime('now'))")

# Save changes
conn.commit()

# Display data
cursor.execute("SELECT * FROM students")

rows = cursor.fetchall()

for row in rows:
    print(row)

# Close connection
conn.close()

