EXPORT REPORT:
import sqlite3
import csv

conn = sqlite3.connect("student.db")
cursor = conn.cursor()

cursor.execute("SELECT * FROM students")

data = cursor.fetchall()

file = open("report.csv", "w", newline="")

writer = csv.writer(file)

writer.writerow(["ID", "Name", "Age", "Gender", "City", "Created At"])

for row in data:
    writer.writerow(row)

file.close()

