STUDENT REPORT CARD:
import sqlite3

conn = sqlite3.connect("student.db")
cursor = conn.cursor()

student_id = int(input("Enter Student ID: "))

cursor.execute("""
SELECT students.name, subjects.subject_name, marks.marks
FROM marks
JOIN students ON students.id = marks.student_id
JOIN subjects ON subjects.id = marks.subject_id
WHERE students.id = ?
""", (student_id,))

data = cursor.fetchall()

total = 0

for row in data:
    print(row[1], ":", row[2])
    total = total + row[2]

print("Total =", total)

if len(data) > 0:
    print("Average =", total / len(data))

conn.close()

