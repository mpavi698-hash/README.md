import json
import os

class Account:
    def __init__(self, account_number, name, pin, balance=0.0, history=None):
        self.account_number = account_number
        self.name = name
        self.pin = pin
        self.balance = float(balance)
        self.history = history if history is not None else []

    def deposit(self, amount):
        if amount <= 0:
            return False, "Amount must be greater than zero."
        self.balance += amount
        self.history.append(f"Deposited: ${amount:.2f}")
        return True, f"Successfully deposited ${amount:.2f}."

    def withdraw(self, amount):
        if amount <= 0:
            return False, "Amount must be greater than zero."
        if amount > self.balance:
            return False, "Insufficient balance!"
        self.balance -= amount
        self.history.append(f"Withdrew: ${amount:.2f}")
        return True, f"Successfully withdrew ${amount:.2f}."

    def to_dict(self):
        return {
            "account_number": self.account_number,
            "name": self.name,
            "pin": self.pin,
            "balance": self.balance,
            "history": self.history
        }


class BankSystem:
    FILE_PATH = "bank_data.json"

    def __init__(self):
        self.accounts = {}
        self.load_data()

    def load_data(self):
        if os.path.exists(self.FILE_PATH):
            try:
                with open(self.FILE_PATH, "r") as f:
                    data = json.load(f)
                    for acc_num, acc_info in data.items():
                        self.accounts[acc_num] = Account(
                            acc_info["account_number"],
                            acc_info["name"],
                            acc_info["pin"],
                            acc_info["balance"],
                            acc_info["history"]
                        )
            except Exception as e:
                print(f"Error loading data: {e}")

    def save_data(self):
        data = {acc_num: acc.to_dict() for acc_num, acc in self.accounts.items()}
        with open(self.FILE_PATH, "w") as f:
            json.dump(data, f, indent=4)

    def create_account(self, name, pin):
        account_number = str(1001 + len(self.accounts))
        new_account = Account(account_number, name, pin)
        self.accounts[account_number] = new_account
        self.save_data()
        return account_number

    def authenticate(self, account_number, pin):
        account = self.accounts.get(account_number)
        if account and account.pin == pin:
            return account
        return None


def main():
    bank = BankSystem()
    print("====================================")
    print("   WELCOME TO ZOHO BANK ATM SYSTEM   ")
    print("====================================")

    while True:
        print("\n--- Main Menu ---")
        print("1. Create New Account")
        print("2. Login to ATM")
        print("3. Exit")
        choice = input("Select an option (1-3): ").strip()

        if choice == "1":
            name = input("Enter your name: ").strip()
            pin = input("Set a 4-digit PIN: ").strip()
            if len(pin) == 4 and pin.isdigit():
                acc_num = bank.create_account(name, pin)
                print(f"\nAccount created successfully! Your Account Number is: {acc_num}")
            else:
                print("Invalid PIN! Must be exactly 4 digits.")

        elif choice == "2":
            acc_num = input("Enter Account Number: ").strip()
            pin = input("Enter 4-Digit PIN: ").strip()
            
            user_acc = bank.authenticate(acc_num, pin)
            if user_acc:
                print(f"\nLogin Successful! Welcome, {user_acc.name}.")
                
                # User Session Menu
                while True:
                    print("\n--- ATM Operations ---")
                    print("1. Check Balance")
                    print("2. Deposit Money")
                    print("3. Withdraw Money")
                    print("4. Transaction History")
                    print("5. Logout")
                    user_choice = input("Choose an operation (1-5): ").strip()

                    if user_choice == "1":
                        print(f"\nYour current balance is: ${user_acc.balance:.2f}")

                    elif user_choice == "2":
                        try:
                            amt = float(input("Enter amount to deposit: "))
                            success, msg = user_acc.deposit(amt)
                            print(msg)
                            if success:
                                bank.save_data()
                        except ValueError:
                            print("Invalid input! Please enter a numerical amount.")

                    elif user_choice == "3":
                        try:
                            amt = float(input("Enter amount to withdraw: "))
                            success, msg = user_acc.withdraw(amt)
                            print(msg)
                            if success:
                                bank.save_data()
                        except ValueError:
                            print("Invalid input! Please enter a numerical amount.")

                    elif user_choice == "4":
                        print("\n--- Transaction History ---")
                        if not user_acc.history:
                            print("No transactions yet.")
                        else:
                            for t in user_acc.history:
                                print(f"- {t}")

                    elif user_choice == "5":
                        print("Logged out successfully.")
                        break
                    else:
                        print("Invalid choice! Try again.")
            else:
                print("\nError: Invalid Account Number or PIN!")

        elif choice == "3":
            print("\nThank you for using Zoho Bank ATM. Goodbye!")
            break
        else:
            print("Invalid option! Please choose between 1 and 3.")

if __name__ == "__main__":
    main()